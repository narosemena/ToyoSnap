{
  "name": "toyosnap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-Egress WorkflowCapture Engine â€” browser extension for instructional designers",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:sast": "semgrep --config=p/owasp-top-ten src/",
    "lint:manifest": "web-ext lint --source-dir dist/ --target chromium",
    "sbom": "cyclonedx-npm --output-format json --output-file sbom.json",
    "licenses": "license-checker --production --json --out licenses.json",
    "test:security": "playwright test --config=tests/playwright.config.ts tests/security/",
    "test:unit": "vitest run tests/unit/",
    "test:coverage": "vitest run tests/unit/ --coverage",
    "test:e2e": "playwright test --config=tests/playwright.config.ts tests/e2e/",
    "test:a11y": "playwright test --config=tests/playwright.config.ts tests/e2e/accessibility.spec.ts",
    "test": "npm run test:security && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "docx": "9.6.1",
    "dom-to-svg": "0.12.2",
    "dompurify": "^3.0.0",
    "idb": "8.0.3",
    "immer": "11.1.4",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rrweb": "1.1.3",
    "rrweb-player": "^1.0.0-alpha.4",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.260",
    "@types/dompurify": "^3.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^2.0.0",
    "license-checker": "^25.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-web-extension": "4.5.1",
    "vitest": "^2.0.0",
    "web-ext": "^8.0.0"
  }
}
