{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node", "chrome"]
  },
  "include": [
    "vite.config.ts",
    "src/manifest.ts",
    "tests/**/*.ts"
  ]
}